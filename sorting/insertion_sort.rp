extern func printf(fmt: cstr, ...) i32

func insertion_sort(xs: []i32) {
  for i in 1..xs.len {
    let key = xs[i]
    var j = i as i32 - 1

    while j >= 0 && xs[j] > key {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = key
  }
}

func print_array(xs: []i32) {
  for x in xs {
    printf("%d ", x)
  }
  printf("\n")
}

func main() i32 {
  var arr = [4,6,3,1,2]

  insertion_sort(arr)
  print_array(arr)

  return 0
}
