import array

func insertion_sort(xs: []i32) {
  for i in 1..xs.len {
    let key = xs[i]
    var j = i as i32 - 1

    while j >= 0 && xs[j] > key {
      xs[j + 1] = xs[j]
      j -= 1
    }
    xs[j + 1] = key
  }
}

func main() i32 {
  var arr = [4,6,3,1,2]

  insertion_sort(arr)
  array.print(arr)

  return 0
}
