extern func printf(fmt: cstr, ...) i32

func bubble_sort(xs: []i32) {
  var n = xs.len
  var swapped: bool = false

  for i in 0..n-1 {
    swapped = false
    for j in 0..n-i-1 {
      if xs[j] > xs[j + 1] {
        xs[j], xs[j + 1] = xs[j + 1], xs[j]
        swapped = true
      }
    }

    if swapped == false {
      break
    }
  }
}

func print_array(xs: []i32) {
  for x in xs {
    printf("%d ", x)
  }
  printf("\n")
}

func main() i32 {
  var arr = [4,5,3,1,2]

  bubble_sort(arr)
  print_array(arr)

  return 0
}
