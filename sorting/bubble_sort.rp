import array

func bubble_sort(xs: []i32) {
  var n = xs.len
  var swapped = false

  for i in 0..n-1 {
    swapped = false
    for j in 0..n-i-1 {
      if xs[j] > xs[j + 1] {
        xs[j], xs[j + 1] = xs[j + 1], xs[j]
        swapped = true
      }
    }

    if swapped == false {
      break
    }
  }
}

func main() i32 {
  var arr = [4,5,3,1,2]

  bubble_sort(arr)
  array.print(arr)

  return 0
}
