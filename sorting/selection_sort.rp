extern func printf(fmt: cstr, ...) i32

import array

func selection_sort(xs: []i32) {
  for i in 0..xs.len - 1 {
    var min_idx = i

    for j in (i + 1)..xs.len {
      if xs[j] < xs[min_idx] {
        min_idx = j
      }
    }

    xs[i], xs[min_idx] = xs[min_idx], xs[i]
  }
}

func main() i32 {
  var arr = [4,6,3,1,2]

  printf("Original array:\n")
  array.print(arr)

  selection_sort(arr)

  printf("Sorted array:\n")
  array.print(arr)

  return 0
}
