extern func printf(fmt: cstr, ...) i32

func linear_search(arr: [5]i32, x: i32) i32 {
  for i in 0..arr.len {
    if arr[i] == x {
      return i as i32
    }
  }
  return -1
}

func main() i32 {
  let arr = [1,2,3,4,5]
  let x = 5
  let result = linear_search(arr, x)

  if result == -1 {
    printf("Element not in array\n")
  } else {
    printf("Element is at index: %d\n", result)
  }

  return 0
}
