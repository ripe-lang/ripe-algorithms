extern func printf(fmt: cstr, ...) i32

func binary_search(xs: []i32, x: i32) i32 {
  var low = 0
  var high = xs.len as i32 - 1

  while low <= high {
    var mid = low + (high - low) / 2

    if xs[mid] == x {
      return mid
    } else if xs[mid] < x {
      low = mid + 1
    } else {
      high = mid - 1
    }
  }

  return -1
}

func main() i32 {
  let arr = [1,2,3,4,5]
  let x = 3
  let result = binary_search(arr, x)

  if result == -1 {
    printf("Element not in array\n")
  } else {
    printf("Element is at index: %d\n", result)
  }

  return 0
}
